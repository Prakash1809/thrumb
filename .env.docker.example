# Deployment configuration for docker-compose.prod.yml.
#
#   cp .env.docker.example .env.docker
#   # fill in the two REQUIRED values below
#   docker compose -f docker-compose.prod.yml --env-file .env.docker up -d
#
# .env.docker is gitignored. Never commit real values.

# ---------------------------------------------------------------------------
# REQUIRED -- the stack refuses to start without these
# ---------------------------------------------------------------------------

# Generate with: openssl rand -base64 32
# Anyone who knows this can mint a session for any account. Rotating it signs
# everyone out.
AUTH_SECRET=

# Postgres password. Not reachable from outside the compose network, but pick a
# real one anyway -- "thrum" is in a public example file.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Strongly recommended for anything reachable from the internet
# ---------------------------------------------------------------------------

# The public origin. Without it, callback URLs and the CSRF origin check fall
# back to the Host header.
AUTH_URL=http://localhost:3000

# Set to 1 only when the reverse proxy in front *overwrites* X-Forwarded-For.
# If the app is directly reachable, leave this at 0 or clients can forge an
# address per request and walk through every per-address rate limit.
TRUST_PROXY=0

# Set to 1 once TLS actually terminates in front of the app.
ENABLE_HSTS=0

# Where the app listens on the host. Leave at 127.0.0.1 and put a reverse proxy
# in front; 0.0.0.0 publishes it directly.
BIND_ADDRESS=127.0.0.1
PORT=3000

# Set to 0 to close public sign-ups and add people by invite link only.
ALLOW_REGISTRATION=1

# ---------------------------------------------------------------------------
# Optional: email. Without SMTP_HOST, password-reset links are written to the
# container log (`docker compose logs app`) instead of being sent.
# ---------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 1 for implicit TLS (port 465). Defaults to on for 465, off otherwise.
SMTP_SECURE=
MAIL_FROM=Thrum <no-reply@example.com>

# ---------------------------------------------------------------------------
# Optional: OAuth. Each provider's button appears once both of its vars are set.
#   GitHub callback: <AUTH_URL>/api/auth/callback/github
#   Google callback: <AUTH_URL>/api/auth/callback/google
# ---------------------------------------------------------------------------

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Optional: other
# ---------------------------------------------------------------------------

POSTGRES_USER=thrum
POSTGRES_DB=thrum

# Per-request upload cap, in bytes. Default 25MB.
MAX_UPLOAD_BYTES=26214400

# Set to 1 to create the demo accounts from the README on first start.
# Do NOT enable this on anything reachable: their password is published.
SEED_DEMO_DATA=0
