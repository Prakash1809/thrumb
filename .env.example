# Copy to .env and fill in. Defaults line up with docker-compose.yml.
# .env is gitignored -- never commit real values.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://thrum:thrum@localhost:5432/thrum?schema=public"

# Signs and encrypts session cookies. Generate with `npx auth secret`, or
# `openssl rand -base64 32`. Treat it like a database password: anyone who has
# it can mint a session for any account. Rotate it and every session is invalid.
AUTH_SECRET=""

# Public origin of the app. Set this in production: without it, callback URLs
# and the CSRF origin check fall back to the Host header.
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# OAuth (optional). A provider's button only appears once both of its vars are
# set. Sign-in is refused unless the provider says the email is verified, so
# neither can be used to claim an address the user does not own.
#   GitHub callback: <AUTH_URL>/api/auth/callback/github
#   Google callback: <AUTH_URL>/api/auth/callback/google
# ---------------------------------------------------------------------------

AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------

# Where attachments are written. Relative paths resolve from the repo root.
# Must NOT be inside ./public -- that would serve user uploads unauthenticated,
# bypassing the channel-membership check in /api/files.
UPLOAD_DIR="var/uploads"

# Per-request cap, in bytes. Default 25MB.
MAX_UPLOAD_BYTES="26214400"

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

PORT="3000"

# Set to 1 ONLY when a reverse proxy you control sits in front and overwrites
# X-Forwarded-For. With it set, that header is believed for rate limiting --
# so if clients can reach the app directly, anyone can forge a fresh identity
# per request and walk through every per-address limit.
TRUST_PROXY="0"

# Set to 1 once TLS actually terminates in front of the app, to send
# Strict-Transport-Security. Read at runtime, so it works with `npm start`.
ENABLE_HSTS="0"

# Set to 0 to close public sign-ups. Existing accounts still sign in, and
# people can still be added with invite links.
ALLOW_REGISTRATION="1"
