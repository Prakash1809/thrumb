{
  "name": "thrum",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, Slack-style team chat: realtime channels, DMs, threads and full-text search. Next.js 15, Postgres and Socket.IO in one Node process.",
  "license": "MIT",
  "keywords": [
    "chat",
    "team-chat",
    "self-hosted",
    "realtime",
    "websockets",
    "socket-io",
    "nextjs",
    "postgresql",
    "prisma",
    "typescript"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && npm run db:seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/core": "^0.40.0",
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/client": "^6.16.1",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "next": "^15.5.4",
    "next-auth": "^5.0.0-beta.29",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "cross-env": "^10.0.0",
    "prisma": "^6.16.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
